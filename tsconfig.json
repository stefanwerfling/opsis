{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "customConditions": ["source"]
  },
  "include": [
    "packages/core/src",
    "packages/server/src",
    "*.ts",
    "packages/core/*.ts",
    "packages/server/*.ts",
    "packages/web/*.ts"
  ]
}
